include README.md README.ko.md LICENSE THIRD_PARTY_NOTICES.md SECURITY.md privacy-policy.json requirements.txt
recursive-include docs *.md
recursive-include scripts *.py
recursive-include packaging *.md *.plist
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] *.log *.sock *.pid

global-exclude .env .env.* auth*.json credentials*.json transcript*.json engine-auth.json last-transcript.txt status.json hud-status.json
